# Copy to .env.local for local dev; in Vercel add these as Environment Variables.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Generate a secret: run  openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret
# Local dev: http://localhost:3000  |  Vercel: your https URL
NEXTAUTH_URL=http://localhost:3000
# Optional: enables AI auto-fill of nutrition macros in the Nutrition tab
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: cross-device data sync (Supabase). Without these the app still works per-device.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider — set ONE. OpenAI (ChatGPT) is used if present, else Anthropic.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Strava integration (free Strava API app at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Fitbit integration (create a Personal app at https://dev.fitbit.com)
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret

# Separate Google Health OAuth (its own registered Google Cloud project/client)
GHEALTH_CLIENT_ID=your-google-health-client-id
GHEALTH_CLIENT_SECRET=your-google-health-client-secret
